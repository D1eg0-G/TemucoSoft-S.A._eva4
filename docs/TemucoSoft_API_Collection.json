{
  "info": {
    "name": "TemucoSoft ERP API Collection",
    "description": "Colección completa de endpoints para el sistema TemucoSoft ERP Multi-tenant",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "temucosoft-api-2025",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url_master",
      "value": "http://localhost:8000/api/master"
    },
    {
      "key": "base_url_basico",
      "value": "http://localhost:8001/api/basico"
    },
    {
      "key": "base_url_medio",
      "value": "http://localhost:8002/api/medio"
    },
    {
      "key": "base_url_premium",
      "value": "http://localhost:8003/api/premium"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "empresa_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "Login Routing (Multi-tenant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('empresa_id', jsonData.empresa_id);",
                  "    pm.environment.set('instance_url', jsonData.instance_url);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empresa.cl\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url_master}}/empresas/login-router/",
              "host": ["{{base_url_master}}"],
              "path": ["empresas", "login-router", ""]
            }
          }
        },
        {
          "name": "Obtener Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    pm.environment.set('refresh_token', jsonData.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@temucosoft.cl\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url_master}}/token/",
              "host": ["{{base_url_master}}"],
              "path": ["token", ""]
            }
          }
        },
        {
          "name": "Refrescar Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url_master}}/token/refresh/",
              "host": ["{{base_url_master}}"],
              "path": ["token", "refresh", ""]
            }
          }
        }
      ]
    },
