# Backend environment example (Master + Basico + Medio + Premium)

# Common
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (override per service if needed)
DB_ENGINE=django.db.backends.postgresql
DB_HOST=localhost
DB_PORT=5432

# Master
DB_NAME=masterdb
DB_USER=master
DB_PASSWORD=master123

# Basico
DB_NAME=basicdb
DB_USER=basic
DB_PASSWORD=basic123

# Medio
DB_NAME=mediodb
DB_USER=medio
DB_PASSWORD=medio123

# Premium
DB_NAME=premiumdb
DB_USER=premium
DB_PASSWORD=premium123
